PORT=3000
# ---- Public links (shown as buttons when set) ----
GITHUB_URL=
LINKEDIN_URL=

# ---- Chat brain ----
# Option A (no key needed): install Ollama + `ollama pull llama3.1`; it is auto-detected at http://localhost:11434.
OLLAMA_MODEL=
# Option B: any OpenAI-compatible API (OpenAI, Groq https://api.groq.com/openai/v1, OpenRouter https://openrouter.ai/api/v1)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional semantic retrieval (e.g. text-embedding-3-small). Empty = BM25.
EMBEDDING_MODEL=
# With neither A nor B the chat still works in OFFLINE mode (CV-only answers).

# ---- Contact form: always saved to data/messages.db (read: python manage.py messages) ----
CONTACT_TO=ahmedsoltani772@gmail.com
# Optional email delivery. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# or Resend (CONTACT_FROM must be a verified sender):
RESEND_API_KEY=
CONTACT_FROM=
